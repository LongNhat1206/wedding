            <div class="g-brick" data-idx="6"><img src="https://i.pinimg.com/1200x/36/da/0d/36da0d406e2d6c25aa7b5c9a75b8a298.jpg"><div class="g-overlay"><span>Không gian trang trí</span></div></div>
            <div class="g-brick" data-idx="7"><img src="https://i.pinimg.com/1200x/9b/bc/9c/9bbc9cb1687c8f8fa4a4c52fcc758583.jpg"><div class="g-overlay"><span>Bình minh hạnh phúc</span></div></div>
