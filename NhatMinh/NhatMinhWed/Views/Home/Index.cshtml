@{
    ViewData["Title"] = "Home Page";
}


<!-- HERO — real wedding photo cover -->
<section id="hero">
    <div class="hero-img-wrap"><img src="https://i.pinimg.com/1200x/3d/24/2c/3d242c1e685ca0622decfce5c3d69e9a.jpg" alt="Long Nhật và Ngọc Minh"></div>
    <div class="hero-scrim"></div>
    <div class="hero-content">
        <div class="hero-mark" data-reveal="up">
            <div class="hero-mark-ring">N&amp;M</div>
            <div class="hero-mark-text">
                <span class="hero-mark-date">18 · 10 · 2026</span>
                <span class="hero-mark-loc">Trân trọng kính mời quý khách</span>
            </div>
        </div>
        <div class="hero-names" data-reveal="up">Long Nhật <span class="amp">&amp;</span> Ngọc Minh</div>
        <div class="hero-ornament" data-reveal="up">
            <svg width="26" height="16" viewBox="0 0 26 16"><path d="M1 8c4-7 8-7 12 0s8 7 12 0" fill="none" stroke="#B08D57" stroke-width="1.2" /><circle cx="13" cy="8" r="2" fill="#B08D57" /></svg>
        </div>
        <div class="hero-invite" data-reveal="up">Chúng tôi trân trọng kính mời bạn đến chung vui trong ngày trọng đại, tổ chức vào <strong>18:00, Chủ Nhật, ngày 18 tháng 10 năm 2026</strong> tại Hà Nội.</div>
        <div class="hero-info" data-reveal="up">
            <div class="venue-card">
                <div class="venue-top"><span class="venue-ico">📍</span><span class="venue-label">Địa điểm tổ chức</span></div>
                <div class="venue-name">Tư gia nhà trai</div>
                <div class="venue-addr">Ngọc Hòa, Ninh Giang, Hải Phòng</div>
                <a class="venue-map" href="https://maps.app.goo.gl/BrdF1nRnnjjr8uuX9" target="_blank" rel="noopener">Xem chỉ đường →</a>
            </div>
            <div class="hero-info-divider"></div>
            <div class="count-card" id="hero-countdown">
                <div class="count-title">Đếm ngược đến ngày vui</div>
                <div class="count-row">
                    <div class="count-unit"><div class="count-num" id="cd-d">--</div><div class="count-lbl">Ngày</div></div>
                    <div class="count-colon">:</div>
                    <div class="count-unit"><div class="count-num" id="cd-h">--</div><div class="count-lbl">Giờ</div></div>
                    <div class="count-colon">:</div>
                    <div class="count-unit"><div class="count-num" id="cd-m">--</div><div class="count-lbl">Phút</div></div>
                    <div class="count-colon">:</div>
                    <div class="count-unit"><div class="count-num" id="cd-s">--</div><div class="count-lbl">Giây</div></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- INTRO -->
<section id="intro" class="tight-top">
    <div class="container intro-grid">
        <div class="intro-photo" data-reveal="left">
            <img src="https://i.pinimg.com/736x/c0/b4/43/c0b44309baf48882f95b71c91f77fe3a.jpg" alt="Rung động">
            <div class="intro-badge">🌿 Khoảnh khắc rung động, Dec 2022</div>
        </div>
        <div class="intro-text" data-reveal="right">
            <div class="eyebrow"><span class="dot"></span>Lời ngỏ</div>
            <p>Người ta nói, hạnh phúc không phải là một điểm đến, mà là một hành trình. Và hành trình của tụi mình sẽ không thể trọn vẹn nếu thiếu đi sự đồng hành, chứng kiến của những người bạn thân thương.</p>
            <p>Một buổi tiệc nhỏ, vài ly rượu mừng và thật nhiều tiếng cười. Tụi mình chính thức mở lời mời bạn đến dự đám cưới của hai đứa. Sự có mặt của bạn chính là món quà tuyệt vời nhất đối với tụi mình.</p>
            <p>Hẹn gặp bạn vào ngày 18 tháng 10 năm 2026</p>
            <div class="intro-sig">Long Nhật &amp; Ngọc Minh</div>
        </div>
    </div>
</section>

<!-- PROGRAMME — stepper -->
<section id="programme">
    <div class="container">
        <div class="sec-head center" data-reveal="up">
            <div class="eyebrow" style="justify-content:center"><span class="dot"></span>Nghi lễ truyền thống</div>
            <h2 class="sec-title">Chương Trình Lễ Cưới</h2>
            <p class="sec-desc">Gìn giữ nét đẹp văn hoá cha ông — trọng lễ nghĩa, đậm ân tình</p>
        </div>
        <div class="stepper" data-reveal="up">
            <div class="stepper-line"><div class="stepper-line-fill" id="stepper-fill"></div></div>
            <div class="stepper-track">
                <div class="step active"><div class="step-dot">🫖</div><div class="step-card"><div class="step-date">15 · 07</div><div class="step-name">Dạm Ngõ</div><div class="step-time">08:00 sáng</div><div class="step-desc">Ngỏ lời xin phép hai bên gia đình</div></div></div>
                <div class="step active"><div class="step-dot">❖</div><div class="step-card"><div class="step-date">17 · 10</div><div class="step-name">Ăn Hỏi</div><div class="step-time">07:30 sáng</div><div class="step-desc">Tráp lễ trầu cau, bánh cốm, phu thê</div></div></div>
                <div class="step active"><div class="step-dot">✦</div><div class="step-card"><div class="step-date">17 · 10</div><div class="step-name">Tiệc mừng</div><div class="step-time">16:30 chiều</div><div class="step-desc">Đại tiệc sum vầy cùng người thân</div></div></div>
                <div class="step active"><div class="step-dot">🌿</div><div class="step-card"><div class="step-date">18 · 10</div><div class="step-name">Vu quy</div><div class="step-time">09:00 sáng</div><div class="step-desc">Lễ tơ hồng, rượu giao bôi</div></div></div>
            </div>
        </div>
    </div>
</section>

<!-- COUPLE INTRO — bride & groom -->
<section id="couple">
    <div class="container">
        <div class="sec-head center" data-reveal="up">
            <div class="eyebrow" style="justify-content:center"><span class="dot"></span>Đôi nét về chúng tôi</div>
            <h2 class="sec-title">Cô Dâu &amp; Chú Rể</h2>
            <p class="sec-desc">Hai con người, một hành trình chung</p>
        </div>
        <div class="couple-grid">
            <div class="couple-card" data-reveal="left">
                <div class="couple-photo-wrap">
                    <div class="couple-photo-ring"></div>
                    <div class="couple-photo"><img src="https://i.pinimg.com/736x/86/c8/b3/86c8b382c68072d5140e4600039ed36c.jpg" alt="Chú rể Long Nhật"></div>
                </div>
                <div class="couple-role">✦ Chú Rể</div>
                <div class="couple-name">Nguyễn Long Nhật</div>
                <div class="couple-family">
                    <div class="family-title">
                        <span class="family-line"></span>
                        <span>Gia đình chú rể</span>
                        <span class="family-line"></span>
                    </div>

                    <div class="family-parents">
                        <div class="parent-item">
                            <span class="parent-label">Thân phụ</span>
                            <span class="parent-name">Ông Nguyễn Thế Giảo</span>
                        </div>

                        <div class="family-heart">❈</div>

                        <div class="parent-item">
                            <span class="parent-label">Thân mẫu</span>
                            <span class="parent-name">Bà Hà Thị Thu Hương</span>
                        </div>
                    </div>
                </div>
                <div class="couple-desc">Một chàng trai yêu công nghệ, thích vào bếp và luôn tìm thấy niềm vui trong những điều nhỏ bé. Điều tuyệt vời nhất là từ nay, những hành trình ấy sẽ có thêm một người để cùng sẻ chia.</div>
            </div>
            <div class="couple-divider" data-reveal="scale">
                <div class="cd-line"></div>
                <div class="cd-mark"><svg width="22" height="22" viewBox="0 0 24 24"><path d="M12 21s-7.5-4.6-10.2-9.3C.2 8.6 1.6 5 5 5c2 0 3.4 1.1 4 2.2C9.6 6.1 11 5 13 5c3.4 0 4.8 3.6 3.2 6.7C13.5 16.4 12 21 12 21z" fill="#7A2E2E" opacity=".85" /></svg></div>
                <div class="cd-line"></div>
            </div>
            <div class="couple-card" data-reveal="right">
                <div class="couple-photo-wrap">
                    <div class="couple-photo-ring"></div>
                    <div class="couple-photo"><img src="https://i.pinimg.com/736x/e2/d2/83/e2d2832c9d9a9528c1e5e67a1d3eb4e2.jpg" alt="Cô dâu Ngọc Minh"></div>
                </div>
                <div class="couple-role">⟡ Cô Dâu</div>
                <div class="couple-name">Vũ Ngọc Minh</div>
                <div class="couple-family">
                    <div class="family-title">
                        <span class="family-line"></span>
                        <span>Gia đình cô dâu</span>
                        <span class="family-line"></span>
                    </div>

                    <div class="family-parents">
                        <div class="parent-item">
                            <span class="parent-label">Thân phụ</span>
                            <span class="parent-name">Ông Vũ Đăng Hòa</span>
                        </div>

                        <div class="family-heart">❈</div>

                        <div class="parent-item">
                            <span class="parent-label">Thân mẫu</span>
                            <span class="parent-name">Bà Lê Thị Đào</span>
                        </div>
                    </div>
                </div>
                <div class="couple-desc">Một cô gái ấm áp, yêu tự do và luôn biết cách mang đến những điều vui vẻ. Với chú rể, cô chính là người khiến những ngày bình thường trở nên đáng nhớ hơn</div>
            </div>
        </div>
    </div>
</section>

<!-- STORY -->
<section id="story">
    <div class="container">
        <div class="sec-head center" data-reveal="up">
            <div class="eyebrow" style="justify-content:center"><span class="dot"></span>Câu chuyện tình yêu</div>
            <h2 class="sec-title">Hành Trình Của Chúng Tôi</h2>
            <p class="sec-desc">Từng chương nhỏ, góp thành câu chuyện lớn</p>
        </div>

        <div class="story-timeline">
            <!-- Mốc 1: Gặp nhau -->
            <div class="story-row" data-reveal="up">
                <div class="story-media"><img src="https://i.pinimg.com/1200x/8b/ef/9f/8bef9fb9367f2a56f64e138937adcaae.jpg" alt="Lần đầu gặp gỡ"></div>
                <div>
                    <div class="story-tag">10.11.2022 · Thế giới ảo, tình yêu thật</div>
                    <div class="story-name">Duyên Số Từ Không Gian Mạng</div>
                    <div class="story-desc">Vào một ngày mùa đông chớm lạnh, hai tâm hồn xa lạ vô tình tìm thấy nhau qua màn hình nhỏ của mạng xã hội. Lời chào đầu tiên giản đơn nhưng lại là khởi đầu cho một sợi dây duyên phận định mệnh.</div>
                </div>
            </div>

            <!-- Mốc 2: Yêu nhau -->
            <div class="story-row" data-reveal="up">
                <div class="story-media"><img src="https://i.pinimg.com/1200x/b9/8e/c4/b98ec4245f192261c9589dc1ce6109dd.jpg" alt="Chính thức yêu nhau"></div>
                <div>
                    <div class="story-tag">18.12.2022 · Ngày bình yên hóa đặc biệt</div>
                    <div class="story-name">Giai Điệu Tình Yêu Cất Lời</div>
                    <div class="story-desc">Chỉ sau một tháng trò chuyện và thấu hiểu, chúng mình nhận ra đối phương chính là mảnh ghép còn thiếu. Ngày 18/12, hai cái tên chính thức đứng cạnh nhau, mở ra một hành trình yêu thương đầy ấm áp giữa mùa đông.</div>
                </div>
            </div>

            <!-- Mốc 3: Đồng hành bên nhau -->
            <div class="story-row" data-reveal="up">
                <div class="story-media"><img src="https://i.pinimg.com/1200x/0f/68/cb/0f68cb9be13da990949966fea3f624da.jpg" alt="Bên nhau thăng trầm"></div>
                <div>
                    <div class="story-tag">2022 - Hiện tại · Đồng hành và Sẻ chia</div>
                    <div class="story-name">Vui Buồn Có Nhau</div>
                    <div class="story-desc">Suốt những năm tháng qua, cuộc sống có lúc thăng lúc trầm, có những ngày ngập tràn tiếng cười và cả những lúc lo toan. Nhưng dẫu thế nào, cái nắm tay vẫn chưa từng nới lỏng, mỗi khoảnh khắc đi qua đều giúp tụi mình trân trọng nhau hơn.</div>
                </div>
            </div>

            <!-- Mốc 4: Đám cưới -->
            <div class="story-row" data-reveal="up">
                <div class="story-media"><img src="https://i.pinimg.com/1200x/55/6f/73/556f73b8505cc92c6200050e9ba7dd3f.jpg" alt="Trái ngọt hôn nhân"></div>
                <div>
                    <div class="story-tag">Mùa cưới 2026 · Trái ngọt tình yêu</div>
                    <div class="story-name">Chương Mới: Về Chung Một Nhà</div>
                    <div class="story-desc">Trải qua bao sóng gió và thử thách, tình yêu của chúng mình đã đủ lớn để đơm hoa kết trái. Một đám cưới trọn vẹn chính là lời khẳng định vững chắc nhất, khép lại một chặng đường yêu để mở ra hành trình làm bạn đời của nhau suốt đời.</div>
                </div>
            </div>
        </div>
    </div>
</section>

