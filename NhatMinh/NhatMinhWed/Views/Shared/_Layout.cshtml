<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Long Nhật & Ngọc Minh · Wedding</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" />
    <meta http-equiv="Cache-Control" content="no-cache">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta http-equiv="Expires" content="-1">
    <meta name="keywords" content="tạo thiệp cưới miễn phí, nhật minh, Thiệp cưới online, Thiệp cưới điện tử, website đám cưới, weddingme, đám cưới online">
    <meta name="description" content="Sử dụng tất cả các tính năng nâng cao, tính năng đặc biệt của thiệp, sử dụng trọn đời.">
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <link rel="canonical" href="" />
    <meta property="og:url" content="" />
    <meta property="og:title" content="Long Nhật & Ngọc Minh · Wedding" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://wedup.io.vn/cdn/img/HTH04755.jpg?v=@DateTime.Now.Ticks" />
    <meta property="og:description" content="Sử dụng Full các tính năng nâng cao, tính năng đặc biệt của thiệp, sử dụng trọn đời." />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/x-icon" href="imgs/logo.ico" />
    <link rel="shortcut icon" href="/imgs/logo.ico" />
    <link rel="apple-touch-icon" href="/imgs/logo.ico" />
    <link rel="apple-touch-icon-precomposed" href="/imgs/logo.ico" />
    <meta name="msapplication-TileImage" content="/imgs/logo.ico" />
    <meta name="revisit-after" content="days" />
    <link rel="dns-prefetch">
</head>
<body>

    <div id="fx-layer"></div>

    <div id="scroll-bar"><div id="scroll-fill"></div></div>

    <div id="loader">
        <div class="loader-ring">
            <svg viewBox="0 0 112 112"><circle class="lr-bg" cx="56" cy="56" r="49" /><circle class="lr-fg" cx="56" cy="56" r="49" /></svg>
            <div class="loader-title">N &amp; M</div>
        </div>
        <div class="loader-mono">18 · 10 · 2026</div>
    </div>

    <audio id="audio" loop preload="none"><source src="~/mp3/music.mp3" type="audio/mpeg"></audio>
    <button id="music-btn" aria-label="Nhạc nền">
        <svg id="ico-play" viewBox="0 0 24 24"><path d="M12 3a9 9 0 100 18A9 9 0 0012 3zm-2 5.5l7 3.5-7 3.5V8.5z" /></svg>
        <svg id="ico-pause" viewBox="0 0 24 24" style="display:none"><path d="M12 3a9 9 0 100 18A9 9 0 0012 3zM9 8h2v8H9V8zm4 0h2v8h-2V8z" /></svg>
    </button>

    <button id="gift-fab" class="gift-fab" aria-label="Mừng cưới - Quét mã QR">
        <span class="gift-fab-pulse"></span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="13" rx="1.5" /><path d="M3 12h18" /><path d="M12 8v13" /><path d="M12 8c-1.5-4-4-5-5.5-3.5S8 8 12 8Z" /><path d="M12 8c1.5-4 4-5 5.5-3.5S16 8 12 8Z" /></svg>
    </button>

    <div id="gift-modal" class="gift-modal-overlay">
        <div class="gift-modal">
            <button class="gift-modal-close" id="gift-modal-close" aria-label="Đóng">✕</button>
            <div class="gift-modal-head">
                <div class="eyebrow" style="justify-content:center"><span class="dot"></span>Hộp mừng cưới</div>
                <h3>Mừng Từ Xa</h3>
                <p>Nếu không thể đến trực tiếp, một lời chúc hoặc chút quà nhỏ từ bạn vẫn là điều quý giá nhất.</p>
            </div>
            <div class="gift-modal-grid">
                <div class="gift-card">
                    <img class="gift-qr-img" src="~/imgs/bank/longnhat.jpg" alt="Mã QR chuyển khoản Nguyễn Long Nhật">
                    <div class="gift-bank">Vietcombank</div>
                    <div class="gift-holder">Nguyễn Long Nhật</div>
                    <div class="gift-num">1014598924</div>
                    <button class="copy-btn" onclick="copyAcc('101 459 8924',this)">Sao chép số tài khoản</button>
                </div>
                <div class="gift-card">
                    <img class="gift-qr-img" src="~/imgs/bank/ngocminh.jpg" alt="Mã QR chuyển khoản Vũ Ngọc Minh">
                    <div class="gift-bank">VIB</div>
                    <div class="gift-holder">Vũ Ngọc Minh</div>
                    <div class="gift-num">395385778</div>
                    <button class="copy-btn" onclick="copyAcc('395 385 778',this)">Sao chép số tài khoản</button>
                </div>
            </div>
        </div>
    </div>

    <div id="live-panel">
        <div class="live-card" id="live-card">
            <div class="live-header" id="live-header">
                <div class="live-header-left"><span class="live-dot"></span><span class="live-title">Lời chúc trực tiếp</span></div>
                <button class="live-toggle-btn" id="live-toggle" aria-label="Thu gọn / mở rộng">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                </button>
            </div>
            <div id="live-ticker">
                <div class="ticker-item static-item"><div class="ticker-av">L</div><div class="ticker-body"><div class="ticker-name">Lan Anh<span class="tk-heart">❤</span></div><div class="ticker-text">Chúc mừng đám cưới Long Nhật và Ngọc Minh! Chúc hai bạn mãi mãi hạnh phúc!</div></div></div>
                <div class="ticker-item static-item"><div class="ticker-av">H</div><div class="ticker-body"><div class="ticker-name">Hùng &amp; Linh<span class="tk-heart">❤</span></div><div class="ticker-text">Ước chúc đôi uyên ương trăm năm hạnh phúc, sum vầy!</div></div></div>
            </div>
        </div>
    </div>

    <nav id="navbar">
        <a class="nav-logo" href="#hero">Long Nhật &amp; Ngọc Minh</a>
        <div class="nav-links">
            <a class="nav-link" href="#programme">Nghi lễ</a>
            <a class="nav-link" href="#couple">Cô dâu &amp; Chú rể</a>
            <a class="nav-link" href="#story">Tình yêu</a>
            <a class="nav-link" href="#gallery">Ảnh cưới</a>
            <a class="nav-link" href="#invite">Sự kiện</a>
            <a class="nav-link" href="#guestbook">Lời chúc</a>
            <a class="nav-cta" href="#rsvp">Xác nhận tham dự</a>
        </div>
        <button class="nav-burger" id="menu-open" aria-label="Mở menu"><span></span><span></span><span></span></button>
    </nav>

    <div id="mmenu">
        <button class="mm-x" id="menu-close">✕</button>
        <ul class="mm-list">
            <li class="mi" style="--i:0"><a href="#hero" onclick="closeMenu()">Trang bìa</a></li>
            <li class="mi" style="--i:1"><a href="#programme" onclick="closeMenu()">Nghi lễ</a></li>
            <li class="mi" style="--i:2"><a href="#couple" onclick="closeMenu()">Cô dâu &amp; Chú rể</a></li>
            <li class="mi" style="--i:3"><a href="#story" onclick="closeMenu()">Tình yêu</a></li>
            <li class="mi" style="--i:4"><a href="#gallery" onclick="closeMenu()">Ảnh cưới</a></li>
            <li class="mi" style="--i:5"><a href="#invite" onclick="closeMenu()">Sự kiện</a></li>
            <li class="mi" style="--i:6"><a href="#rsvp" onclick="closeMenu()">RSVP</a></li>
            <li class="mi" style="--i:7"><a href="#guestbook" onclick="closeMenu()">Lời chúc</a></li>
        </ul>
    </div>
    @RenderBody()
    <!-- RSVP -->
    <section id="rsvp">
        <div class="container-narrow">
            <div class="sec-head center" data-reveal="up">
                <div class="eyebrow" style="justify-content:center"><span class="dot"></span>Xác nhận tham dự</div>
                <h2 class="sec-title">Bạn Có Đến Không?</h2>
                <p class="sec-desc" style="margin:0 auto">Vui lòng xác nhận trước ngày 17/10/2026 để chúng tôi chuẩn bị chu đáo nhé!</p>
            </div>
            <div class="rsvp-card" data-reveal="up">
                <div id="rsvp-inner">
                    <div class="toggle-row">
                        <button class="toggle-btn on" id="btn-yes" onclick="setAtt('yes')">Tôi sẽ đến</button>
                        <button class="toggle-btn" id="btn-no" onclick="setAtt('no')">Không đến được</button>
                    </div>
                    <label class="form-label">Họ và tên *</label>
                    <input class="form-input" id="rv-name" placeholder="Nguyễn Văn A" type="text">
                    <label class="form-label">Số điện thoại</label>
                    <input class="form-input" id="rv-phone" placeholder="09xx xxx xxx" type="tel">
                    <label class="form-label">Tham dự bữa nào?</label>
                    <label class="form-label">Số người đi cùng</label>
                    <select class="form-input" id="rv-guests"><option>Chỉ mình tôi</option><option>2 người</option><option>3 người</option><option>4+ người</option></select>
                    <label class="form-label">Lời nhắn</label>
                    <textarea class="form-input" id="rv-msg" style="min-height:78px;resize:vertical" placeholder="Lời chúc hoặc yêu cầu đặc biệt của bạn..."></textarea>
                    <button class="btn-submit" onclick="submitRSVP()">Xác nhận tham dự</button>
                </div>
                <div id="rsvp-success">
                    <div class="si">Cảm ơn bạn!</div>
                    <p>Chúng tôi đã nhận được xác nhận của bạn.<br>Hẹn gặp lại vào ngày 18/10/2026 nhé!</p>
                </div>
            </div>
        </div>
    </section>

    <!-- GUESTBOOK -->
    <section id="guestbook">
        <div class="container-narrow">
            <div class="sec-head center" data-reveal="up">
                <div class="eyebrow" style="justify-content:center"><span class="dot"></span>Sổ lưu bút</div>
                <h2 class="sec-title">Gửi Lời Chúc</h2>
                <p class="sec-desc" style="margin:0 auto">Lời chúc của bạn sẽ hiện ngay lên màn hình trực tiếp ở góc trái, giống như một khách mời đang chúc mừng ngay lúc này</p>
            </div>
            <div class="gb-form gb-single" data-reveal="up">
                <input class="gb-in" id="gb-name" placeholder="Tên của bạn *" type="text">
                <div class="emoji-bar">
                    <button class="emoji-btn" onclick="appendEmoji('❤️')">❤️</button>
                    <button class="emoji-btn" onclick="appendEmoji('🎉')">🎉</button>
                    <button class="emoji-btn" onclick="appendEmoji('💍')">💍</button>
                    <button class="emoji-btn" onclick="appendEmoji('🥂')">🥂</button>
                    <button class="emoji-btn" onclick="appendEmoji('🌸')">🌸</button>
                </div>
                <textarea class="gb-ta" id="gb-text" placeholder="Gửi lời chúc mừng đến cặp đôi hạnh phúc..."></textarea>
                <button class="gb-submit" onclick="sendWish()">Gửi lời chúc</button>
                <div id="gb-sent">💌 Đã gửi! Lời chúc của bạn đang hiển thị ở góc màn hình.</div>
            </div>
        </div>
    </section>

    <!-- THANKS -->
    <section id="thanks">
        <div class="container">
            <div class="thanks-sig" data-reveal="up">Gửi trọn niềm trân quý</div>
            <div class="thanks-quote" data-reveal="up">"Hành trình hạnh phúc của chúng tôi sẽ không thể vẹn tròn nếu thiếu đi tình yêu thương, sự đồng hành và những lời chúc phúc từ mọi người. Cảm ơn bạn vì đã luôn là một phần thật đẹp trong chương mới ý nghĩa này của cuộc đời chúng tôi."</div>
            <div class="thanks-names" data-reveal="up">Long Nhật &amp; Ngọc Minh</div>
            <div class="thanks-footer" data-reveal="up">Thiệp cưới trực tuyến Long Nhật · 18 · 10 · 2026 · Hà Nội, Việt Nam</div>
        </div>
    </section>

    <script>
            try{

            // ── LOADER ──
            window.addEventListener('load',()=>{setTimeout(()=>{const l=document.getElementById('loader');l.classList.add('done');setTimeout(()=>l.remove(),1050);},2000);});

            // ── SCROLL PROGRESS + NAVBAR ──
            let ticking=false;
            function onScroll(){
              const max=document.body.scrollHeight-window.innerHeight;
              document.getElementById('scroll-fill').style.width=(window.scrollY/max*100)+'%';
              document.getElementById('navbar').classList.toggle('scrolled',window.scrollY>40);
              ticking=false;
            }
            window.addEventListener('scroll',()=>{if(!ticking){requestAnimationFrame(onScroll);ticking=true;}},{passive:true});

            // ── MOBILE MENU ──
            function openMenu(){document.getElementById('mmenu').classList.add('open');document.body.style.overflow='hidden';}
            function closeMenu(){document.getElementById('mmenu').classList.remove('open');document.body.style.overflow='';}
            document.getElementById('menu-open').onclick=openMenu;
            document.getElementById('menu-close').onclick=closeMenu;
            document.getElementById('mmenu').addEventListener('click',e=>{if(e.target===document.getElementById('mmenu'))closeMenu();});
            document.addEventListener('keydown',e=>{if(e.key==='Escape')closeMenu();});

            // ── COUNTDOWN (D/H/M/S, smooth flip on change) ──
            let prevCd={d:null,h:null,m:null,s:null};
            function setCd(id,val,key){
              const el=document.getElementById(id);
              if(prevCd[key]!==val){
                el.textContent=val;
                el.classList.remove('flip');void el.offsetWidth;el.classList.add('flip');
                prevCd[key]=val;
              }
            }
            function tick(){
              const diff=new Date('2026-10-18T18:00:00')-new Date();
              if(diff<=0){['cd-d','cd-h','cd-m','cd-s'].forEach(id=>document.getElementById(id).textContent='0');return;}
              setCd('cd-d',Math.floor(diff/86400000),'d');
              setCd('cd-h',Math.floor(diff%86400000/3600000),'h');
              setCd('cd-m',Math.floor(diff%3600000/60000),'m');
              setCd('cd-s',Math.floor(diff%60000/1000),'s');
            }
            tick();setInterval(tick,1000);

            // ── MUSIC ──
            const aud = document.getElementById('audio');
            const musicBtn = document.getElementById('music-btn');
            const iPlay = document.getElementById('ico-play');
            const iPause = document.getElementById('ico-pause');

            let playing = false;

            // 1. Hàm đồng bộ giao diện (UI) với trạng thái nhạc
            function updateMusicUI() {
              if (playing) {
                iPlay.style.display = 'none';
                iPause.style.display = '';
                musicBtn.classList.add('playing');
              } else {
                iPlay.style.display = '';
                iPause.style.display = 'none';
                musicBtn.classList.remove('playing');
              }
            }

            // 2. Xử lý khi click TRỰC TIẾP vào nút bật/tắt nhạc
            musicBtn.addEventListener('click', (event) => {
              // Ngăn chặn sự kiện click này lan ra ngoài toàn trang (tránh xung đột với hàm bên dưới)
              event.stopPropagation();

              playing = !playing;
              if (playing) {
                aud.play().catch(() => {});
              } else {
                aud.pause();
              }
              updateMusicUI();
            });

            // 3. Xử lý khi click/chạm BẤT KỲ ĐÂU trên trang (Chỉ gọi 1 lần duy nhất)
            function playOnFirstInteraction() {
              // Chỉ phát nếu nhạc chưa được bật
              if (!playing) {
                aud.play().then(() => {
                  playing = true;
                  updateMusicUI(); // Cập nhật icon sang trạng thái đang phát
                }).catch((error) => {
                  console.warn('Lỗi phát nhạc:', error);
                });
              }
            }

            // Lắng nghe sự kiện click (máy tính) và touchstart (điện thoại) trên toàn bộ tài liệu
            // { once: true } đảm bảo nó chỉ chạy đúng 1 lần rồi tự hủy, không gây gánh nặng cho web
            document.addEventListener('click', playOnFirstInteraction, { once: true });
            document.addEventListener('touchstart', playOnFirstInteraction, { once: true });


            // ── SCROLL REVEAL ──
            const io=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('revealed');io.unobserve(e.target);}});},{threshold:.12});
            document.querySelectorAll('[data-reveal]').forEach(el=>io.observe(el));

            // ── STEPPER LINE FILL ON SCROLL INTO VIEW ──
            const stepperIo=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){document.getElementById('stepper-fill').style.width='100%';stepperIo.unobserve(e.target);}});},{threshold:.4});
            const stepperEl=document.querySelector('.stepper');
            if(stepperEl)stepperIo.observe(stepperEl);

            // ── TABS ──
            const tabBtns=[...document.querySelectorAll('.tab-btn')];
            const tabPill=document.getElementById('tab-pill');
            tabBtns.forEach((btn,i)=>{
              btn.onclick=()=>{
                tabBtns.forEach(b=>b.classList.remove('active'));
                document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
                btn.classList.add('active');
                document.getElementById('panel-'+btn.dataset.tab).classList.add('active');
                if(tabPill)tabPill.style.transform='translateX('+(i*100)+'%)';
              };
            });

            // ── GALLERY + LIGHTBOX ──
            const galleryData=[
              {src:'https://i.pinimg.com/1200x/d1/31/45/d13145ad1d137b2b875ea8d8ec14f893.jpg',cap:'Pre-Wedding · Hội An'},
              {src:'https://i.pinimg.com/1200x/9f/1e/5e/9f1e5e9685983a58db074516336062f7.jpg',cap:'Cô dâu'},
              {src:'https://i.pinimg.com/1200x/7f/8e/92/7f8e926b904b890164025747490d1e56.jpg',cap:'Nhẫn cưới'},
              {src:'https://i.pinimg.com/1200x/7f/8e/92/7f8e926b904b890164025747490d1e56.jpg',cap:'Dạo phố · Hà Nội'},
              {src:'https://i.pinimg.com/1200x/5a/5e/9a/5a5e9af7f7cdd35dd0653ce7334aba22.jpg',cap:'Khoảnh khắc lãng mạn'},
              {src:'https://i.pinimg.com/1200x/66/16/64/661664161889cf0f7cefc95a78e0739b.jpg',cap:'Hoa cưới'},
              {src:'https://i.pinimg.com/1200x/36/da/0d/36da0d406e2d6c25aa7b5c9a75b8a298.jpg',cap:'Không gian trang trí'},
              {src:'https://i.pinimg.com/1200x/9b/bc/9c/9bbc9cb1687c8f8fa4a4c52fcc758583.jpg',cap:'Bình minh hạnh phúc'},
            ];
            let lbIdx=0;
            const lb=document.getElementById('lightbox'),lbImg=document.getElementById('lb-img'),lbCap=document.getElementById('lb-cap'),lbDots=document.getElementById('lb-dots');
            function buildDots(){lbDots.innerHTML='';galleryData.forEach((_,i)=>{const d=document.createElement('div');d.className='lb-dot'+(i===lbIdx?' active':'');d.onclick=()=>showLB(i);lbDots.appendChild(d);});}
            function showLB(i){
              lbIdx=(i+galleryData.length)%galleryData.length;
              lbImg.classList.remove('show');
              setTimeout(()=>{lbImg.src=galleryData[lbIdx].src;lbCap.textContent=galleryData[lbIdx].cap+' · '+(lbIdx+1)+' / '+galleryData.length;lbImg.onload=()=>lbImg.classList.add('show');},160);
              buildDots();
            }
            document.querySelectorAll('.g-brick').forEach(el=>{el.onclick=()=>{showLB(parseInt(el.dataset.idx));lb.classList.add('open');};});
            document.getElementById('lb-x').onclick=()=>lb.classList.remove('open');
            lb.onclick=e=>{if(e.target===lb)lb.classList.remove('open');};
            document.getElementById('lb-prev').onclick=()=>showLB(lbIdx-1);
            document.getElementById('lb-next').onclick=()=>showLB(lbIdx+1);
            document.addEventListener('keydown',e=>{
              if(!lb.classList.contains('open'))return;
              if(e.key==='Escape')lb.classList.remove('open');
              if(e.key==='ArrowLeft')showLB(lbIdx-1);
              if(e.key==='ArrowRight')showLB(lbIdx+1);
            });
            let lbTx=0;
            lb.addEventListener('touchstart',e=>{lbTx=e.touches[0].clientX;},{passive:true});
            lb.addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-lbTx;if(Math.abs(dx)>40)dx<0?showLB(lbIdx+1):showLB(lbIdx-1);});

            // ── RSVP ──
            let attStatus='yes';
            function setAtt(v){attStatus=v;document.getElementById('btn-yes').classList.toggle('on',v==='yes');document.getElementById('btn-no').classList.toggle('on',v==='no');}
            function submitRSVP(){
              const n=document.getElementById('rv-name').value.trim();
              if(!n){alert('Vui lòng nhập họ tên của bạn!');return;}
              document.getElementById('rsvp-inner').style.display='none';
              document.getElementById('rsvp-success').style.display='block';
            }

            // ── COPY ──
            function copyAcc(text,btn){
              navigator.clipboard.writeText(text.replace(/\s/g,'')).then(()=>{
                const orig=btn.textContent;btn.textContent='Đã chép!';btn.classList.add('done');
                setTimeout(()=>{btn.textContent=orig;btn.classList.remove('done');},2200);
              });
            }

            }catch(err){console.error('Wedding page init error (non-fatal):',err);}

            // ── GIFT FAB: draggable anywhere on screen, click (no drag) opens QR modal ──
            (function(){
              const fab=document.getElementById('gift-fab');
              const modal=document.getElementById('gift-modal');
              const closeBtn=document.getElementById('gift-modal-close');
              if(!fab||!modal||!closeBtn)return;
              let dragging=false,moved=false,startX=0,startY=0,origX=0,origY=0;
              function pointerDown(e){
                dragging=true;moved=false;
                const r=fab.getBoundingClientRect();
                fab.style.left=r.left+'px';fab.style.top=r.top+'px';
                fab.style.right='auto';fab.style.bottom='auto';
                origX=r.left;origY=r.top;
                startX=(e.touches?e.touches[0].clientX:e.clientX);
                startY=(e.touches?e.touches[0].clientY:e.clientY);
                fab.classList.add('dragging');
                document.addEventListener('mousemove',pointerMove);
                document.addEventListener('mouseup',pointerUp);
                document.addEventListener('touchmove',pointerMove,{passive:false});
                document.addEventListener('touchend',pointerUp);
              }
              function pointerMove(e){
                if(!dragging)return;
                const cx=(e.touches?e.touches[0].clientX:e.clientX);
                const cy=(e.touches?e.touches[0].clientY:e.clientY);
                const dx=cx-startX,dy=cy-startY;
                if(Math.abs(dx)>4||Math.abs(dy)>4)moved=true;
                if(moved&&e.cancelable)e.preventDefault();
                let nx=origX+dx,ny=origY+dy;
                const maxX=window.innerWidth-fab.offsetWidth-6,maxY=window.innerHeight-fab.offsetHeight-6;
                nx=Math.max(6,Math.min(maxX,nx));ny=Math.max(6,Math.min(maxY,ny));
                fab.style.left=nx+'px';fab.style.top=ny+'px';
              }
              function pointerUp(){
                dragging=false;
                fab.classList.remove('dragging');
                document.removeEventListener('mousemove',pointerMove);
                document.removeEventListener('mouseup',pointerUp);
                document.removeEventListener('touchmove',pointerMove);
                document.removeEventListener('touchend',pointerUp);
                if(!moved)openGiftModal();
              }
              fab.addEventListener('mousedown',pointerDown);
              fab.addEventListener('touchstart',pointerDown,{passive:true});
              function openGiftModal(){modal.classList.add('open');}
              function closeGiftModal(){modal.classList.remove('open');}
              closeBtn.addEventListener('click',closeGiftModal);
              modal.addEventListener('click',e=>{if(e.target===modal)closeGiftModal();});
              document.addEventListener('keydown',e=>{if(e.key==='Escape')closeGiftModal();});
              window.addEventListener('resize',()=>{
                if(fab.style.left){
                  const maxX=window.innerWidth-fab.offsetWidth-6,maxY=window.innerHeight-fab.offsetHeight-6;
                  fab.style.left=Math.max(6,Math.min(maxX,parseFloat(fab.style.left)))+'px';
                  fab.style.top=Math.max(6,Math.min(maxY,parseFloat(fab.style.top)))+'px';
                }
              });
            })();

            // ── LIVE CORNER PANEL (collapse/expand) ──
            (function(){
              const card=document.getElementById('live-card');
              const header=document.getElementById('live-header');
              if(!card||!header)return;
              header.addEventListener('click',()=>{card.classList.toggle('collapsed');});
            })();

            // ── LIVE CORNER TICKER (only place wishes are displayed) ──
            // Declared at top level (not nested) so pushTicker/tickerQueue stay
            // reachable from sendWish() below even if something earlier failed.
            const initWishes=[
              {name:'Lan Anh',text:'Chúc mừng đám cưới Long Nhật và Ngọc Minh! Chúc hai bạn mãi mãi hạnh phúc, sức khoẻ và thịnh vượng!'},
              {name:'Hùng & Linh',text:'Ước chúc đôi uyên ương trăm năm hạnh phúc. Gia đình luôn sum vầy, ấm áp yêu thương!'},
              {name:'Minh Châu',text:'Tình yêu đẹp nhất là khi hai người cùng nhìn về một hướng. Chúc mừng hai bạn!'},
              {name:'Team công ty',text:'Cả team chúc mừng anh Long Nhật và chị Ngọc Minh! Hạnh phúc mãi mãi nhé!'},
              {name:'Bà Phương',text:'Cháu ơi, bà chúc hai đứa trăm năm hạnh phúc, sớm sinh quý tử nhé!'},
              {name:'Hội bạn thân',text:'Cả hội cấp 3 chúc mừng đám cưới! Nhớ đặt bàn xịn cho tụi mình nha!'},
              {name:'Thầy Hùng',text:'Thầy chúc mừng em! Hạnh phúc bền lâu, sự nghiệp thịnh vượng nhé!'},
              {name:'Nhóm du lịch',text:'Tụi mình từ Đà Nẵng gửi lời chúc mừng đến hai bạn!'},
              {name:'Thanh Hương',text:'Chúc đôi bạn trăm năm hạnh phúc, mãi yêu thương và nâng đỡ nhau!'},
              {name:'Anh Khôi',text:'Tình yêu là món quà quý giá nhất. Chúc mừng cặp đôi đẹp nhất Hà Nội!'},
              {name:'Cô Hoa',text:'Chúc cháu trăm năm bền vững, phúc lộc đầy nhà!'},
              {name:'Bạn Quân',text:'Chúc mừng mày! Cuối cùng cũng cưới được cô ấy rồi. Hạnh phúc mãi nhé!'},
              {name:'Dì Bình',text:'Chúc hai con trăm năm hạnh phúc, sớm sinh cháu ngoại cho bà bế!'},
            ];
            const tickerEl=document.getElementById('live-ticker');
            // FLIP helper: measure item positions before a DOM mutation, then after the
            // mutation nudge each surviving item back from its old spot to its new one
            // via a transform, so the browser animates the move instead of snapping.
            function flipTicker(mutate){
              const before=new Map();
              [...tickerEl.children].forEach(el=>before.set(el,el.getBoundingClientRect()));
              mutate();
              [...tickerEl.children].forEach(el=>{
                const prev=before.get(el);
                if(!prev)return;
                const now=el.getBoundingClientRect();
                const dy=prev.top-now.top;
                if(Math.abs(dy)>0.5){
                  el.style.transitionProperty='none';
                  el.style.setProperty('--ty',dy+'px');
                  void el.offsetHeight;
                  requestAnimationFrame(()=>{
                    el.style.transitionProperty='';
                    el.style.setProperty('--ty','0px');
                  });
                }
              });
            }
            function pushTicker(w){
              const item=document.createElement('div');item.className='ticker-item';
              item.innerHTML=`<div class="ticker-av">${w.name.charAt(0).toUpperCase()}</div><div class="ticker-body"><div class="ticker-name">${w.name}<span class="tk-heart">❤</span></div><div class="ticker-text">${w.text}</div></div>`;
              flipTicker(()=>{
                tickerEl.appendChild(item);
                const maxVisible=window.matchMedia('(max-width:640px)').matches?2:4;
                if(tickerEl.children.length>maxVisible){const old=tickerEl.firstChild;if(old&&old!==item)tickerEl.removeChild(old);}
              });
              // Force a reflow, then flip to visible so the CSS transition reliably fires
              void item.offsetHeight;
              requestAnimationFrame(()=>{requestAnimationFrame(()=>{item.classList.add('in');});});
              setTimeout(()=>{
                item.classList.remove('in');
                item.classList.add('out');
                setTimeout(()=>{
                  flipTicker(()=>{if(item.parentNode)item.parentNode.removeChild(item);});
                },650);
              },6800);
            }
            const tickerQueue=[...initWishes];
            let tickerQIdx=0;
            function dripTicker(){
              if(tickerQIdx===0){
                document.querySelectorAll('.static-item').forEach(el=>{
                  el.classList.add('fade-out');
                  setTimeout(()=>{
                    flipTicker(()=>{if(el.parentNode)el.parentNode.removeChild(el);});
                  },650);
                });
              }
              pushTicker(tickerQueue[tickerQIdx%tickerQueue.length]);
              tickerQIdx++;
              setTimeout(dripTicker,1700+Math.random()*1500);
            }
            setTimeout(dripTicker,400);

            function appendEmoji(e){const ta=document.getElementById('gb-text');ta.value+=e;ta.focus();}
            function sendWish(){
              const name=document.getElementById('gb-name').value.trim();
              const text=document.getElementById('gb-text').value.trim();
              if(!name||!text){alert('Vui lòng nhập tên và lời chúc!');return;}
              pushTicker({name,text});
              tickerQueue.unshift({name,text});
              const sent=document.getElementById('gb-sent');
              sent.classList.add('show');
              setTimeout(()=>sent.classList.remove('show'),3200);
              document.getElementById('gb-name').value='';document.getElementById('gb-text').value='';
            }

            // ── AMBIENT FX: hearts, petals, snow, kisses, bubbles — lush but tasteful ──
            (function(){
              const layer=document.getElementById('fx-layer');
              const kinds=[
                {glyphs:['💗','❤️','💕'],size:[13,22],dur:[8,13],drift:34,sway:1,weight:3},
                {glyphs:['🌸','🌺','🌷'],size:[15,24],dur:[9,15],drift:42,sway:1.3,spin:true,weight:3},
                {glyphs:['❄️'],size:[10,17],dur:[7,12],drift:26,sway:.8,spin:true,weight:2},
                {glyphs:['💋'],size:[14,19],dur:[9,14],drift:30,sway:.9,weight:1.4},
                {glyphs:['🫧'],size:[8,16],dur:[8,13],drift:24,sway:.6,rise:true,weight:2},
                {glyphs:['✨'],size:[9,14],dur:[8,12],drift:20,sway:.5,weight:1.2},
              ];
              const pool=[];
              kinds.forEach(k=>{for(let i=0;i<Math.round(k.weight*4);i++)pool.push(k);});

              function spawn(){
                const k=pool[Math.floor(Math.random()*pool.length)];
                const el=document.createElement('span');
                el.className='fx-piece';
                el.textContent=k.glyphs[Math.floor(Math.random()*k.glyphs.length)];
                const depth=.55+Math.random()*.7;                 // parallax depth: closer = bigger & more opaque
                const size=(k.size[0]+Math.random()*(k.size[1]-k.size[0]))*depth;
                const dur=(k.dur[0]+Math.random()*(k.dur[1]-k.dur[0]))/depth;
                const startX=Math.random()*100;
                const drift=(Math.random()*2-1)*k.drift;
                const sway=(k.sway||1)*(10+Math.random()*14);
                const maxOpacity=.35+depth*.45;
                el.style.left='calc('+startX+'vw - 20px)';
                el.style.fontSize=size+'px';
                el.style.filter='blur('+((1-depth)*1.1)+'px)';
                if(k.rise){el.style.top='auto';el.style.bottom='-40px';}
                layer.appendChild(el);
                const rot=(k.spin?(drift>0?1:-1)*(50+Math.random()*70):0);
                const midY=(k.rise?'-45vh':'45vh'), endY=(k.rise?'-108vh':'108vh');
                const anim=el.animate([
                  {transform:'translate(0,0) rotate(0deg)',opacity:0},
                  {transform:'translate('+(sway*.6)+'px,'+ (k.rise?'-14vh':'14vh') +') rotate('+(rot*.25)+'deg)',opacity:maxOpacity,offset:.12},
                  {transform:'translate('+(-sway*.5+drift*.4)+'px,'+midY+') rotate('+(rot*.6)+'deg)',opacity:maxOpacity,offset:.5},
                  {transform:'translate('+(drift)+'px,'+endY+') rotate('+rot+'deg)',opacity:0}
                ],{duration:dur*1000,easing:'ease-in-out'});
                anim.onfinish=()=>el.remove();
              }
              function loop(){
                const burst=1+(Math.random()<0.35?1:0);   // occasionally spawn two at once for a fuller feel
                for(let i=0;i<burst;i++)spawn();
                const next=380+Math.random()*520;
                setTimeout(loop,next);
              }
              setTimeout(loop,900);
            })();
    </script>

    <style>

    </style>
    <div id="loaderOverlay"><div class="loaderRing"></div></div>
    <div id="weatherBox">Đang tải thời tiết...</div>
    <script>
            window.addEventListener('load',()=>setTimeout(()=>loaderOverlay.classList.add('hide'),900));
            fetch('https://api.open-meteo.com/v1/forecast?latitude=21.0285&longitude=105.8542&current=temperature_2m')
            .then(r=>r.json()).then(d=>weatherBox.innerHTML='🌤️ Hà Nội<br>'+d.current.temperature_2m+'°C').catch(()=>weatherBox.innerHTML='🌤️ Hà Nội');
    </script>
</body>
